# Copy to apps/api/.env. The API reads that file; existing shell variables win.
# Never put provider credentials in apps/web or any NEXT_PUBLIC_* variable.
KIVO_ALLOW_DEV_AUTH=1
KIVO_DEV_TOKEN=replace-with-a-random-token-at-least-32-characters

# Local PostgreSQL works without cloud accounts.
DATABASE_URL=postgres://kivo:kivo_local_only@127.0.0.1:5432/kivo
# Neon: replace DATABASE_URL with the pooled URL and uncomment its direct pair.
# DATABASE_URL=postgresql://ROLE:PASSWORD@ep-EXAMPLE-pooler.us-east-2.aws.neon.tech/neondb?sslmode=verify-full
# DATABASE_DIRECT_URL=postgresql://ROLE:PASSWORD@ep-EXAMPLE.us-east-2.aws.neon.tech/neondb?sslmode=verify-full
KIVO_DB_MAX_CONNECTIONS=5
# Local startup launches kivo-migrator; npm run dev:api builds both binaries.
# Use 0 after a separate npm run db:migrate step.
KIVO_RUN_MIGRATIONS=1

# Both values enable Redis; leave both unset to run without Redis locally.
# Use the read/write REST token, not the read-only token.
# UPSTASH_REDIS_REST_URL=https://YOUR-DATABASE.upstash.io
# UPSTASH_REDIS_REST_TOKEN=YOUR-READ-WRITE-TOKEN
KIVO_REDIS_PREFIX=kivo:dev
KIVO_RATE_LIMIT_PER_MINUTE=120

# Neon Object Storage: use the private bucket and credentials from one Neon branch.
# AWS_* names are S3 SDK conventions; use the values issued by Neon.
# Set KIVO_S3_BUCKET to the S3_BUCKET value in Neon's credentials export.
# KIVO_S3_BUCKET=YOUR-PRIVATE-BUCKET
# AWS_ENDPOINT_URL_S3=https://YOUR-BRANCH-STORAGE-ENDPOINT
# AWS_REGION=YOUR-NEON-STORAGE-REGION
# AWS_ACCESS_KEY_ID=YOUR-NEON-ACCESS-KEY
# AWS_SECRET_ACCESS_KEY=YOUR-NEON-SECRET-KEY
# The backend uses path-style addressing. Leave KIVO_S3_ENDPOINT_URL unset;
# that separate endpoint override is reserved for loopback test fixtures.
KIVO_S3_PREFIX=kivo-dev

# Shared mode: replace development auth with these settings. See docs/auth0-setup.md.
# KIVO_AUTH_MODE=auth0
# AUTH0_ISSUER=https://YOUR-TENANT.us.auth0.com/
# AUTH0_AUDIENCE=https://api.kivo.app
# Set KIVO_RUN_MIGRATIONS=0 above and run npm run db:migrate separately.
# KIVO_API_BIND=127.0.0.1:4000
