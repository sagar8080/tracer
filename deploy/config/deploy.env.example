# Deployment controls only; runtime secrets go in the five files below.
SITE_HOST=kivolabs.pro
ACME_EMAIL=YOUR-OPERATIONS-EMAIL
KIVO_IMAGE_PREFIX=ghcr.io/sagar8080/kivo
# Full 40-character Git commit SHA output by the image workflow; never latest.
KIVO_RELEASE=YOUR-RELEASE-COMMIT-SHA
KIVO_ENV_DIR=/etc/kivo
