AUTH0_DOMAIN=YOUR-TENANT.us.auth0.com
AUTH0_CLIENT_ID=YOUR-PRODUCTION-REGULAR-WEB-APP-CLIENT-ID
AUTH0_CLIENT_SECRET=YOUR-PRODUCTION-CLIENT-SECRET
# Generate with openssl rand -hex 32; retain across releases/web replicas.
AUTH0_SECRET=YOUR-64-HEX-CHARACTER-SESSION-SECRET
# Use the existing API identifier; it need not match the purchased domain.
AUTH0_AUDIENCE=https://api.kivo.app
