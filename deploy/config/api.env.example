DATABASE_URL=YOUR-NEON-POOLED-POSTGRES-URL
KIVO_DB_MAX_CONNECTIONS=5
AUTH0_ISSUER=https://YOUR-TENANT.us.auth0.com/
AUTH0_AUDIENCE=https://api.kivo.app
KIVO_S3_BUCKET=YOUR-PRIVATE-NEON-BUCKET
KIVO_S3_PREFIX=kivo-pilot
AWS_ENDPOINT_URL_S3=https://YOUR-NEON-STORAGE-ENDPOINT
AWS_REGION=YOUR-NEON-STORAGE-REGION
AWS_ACCESS_KEY_ID=YOUR-NEON-ACCESS-KEY
AWS_SECRET_ACCESS_KEY=YOUR-NEON-SECRET-KEY
# Optional mapping assistance: both key and explicit model ID are required.
# Configure the same provider/model pairs in worker.env. No Redis is required.
# OPENAI_API_KEY=YOUR-KEY
# KIVO_OPENAI_MODEL=YOUR-MODEL
# ANTHROPIC_API_KEY=YOUR-KEY
# KIVO_CLAUDE_MODEL=YOUR-MODEL
# GEMINI_API_KEY=YOUR-KEY
# KIVO_GEMINI_MODEL=YOUR-MODEL
